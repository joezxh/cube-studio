# Web-only 单机部署镜像（无 k8s 调度，仅 myapp Web 端）
# 在项目根目录执行:
# docker build -t cube-studio-dashboard:web-local -f install/docker/Dockerfile.web .
# 说明: 相比原 Dockerfile 去掉了 aihub.zip 下载与 COPY aihub（基础镜像内已自带 /cube-studio/aihub，
#       且本地工程无 aihub 目录，COPY 会失败/覆盖为空）。

FROM ccr.ccs.tencentyun.com/cube-studio/kubeflow-dashboard:base-python3.9-20260501

COPY myapp /home/myapp/myapp
COPY myapp/static/appbuilder/frontend /data/web/frontend

ENV PATH=/home/myapp/myapp/bin:${PATH:-}
ENV PYTHONPATH=/home/myapp:${PYTHONPATH:-}

COPY install/docker/entrypoint-web.sh /entrypoint.sh
RUN chmod +x /home/myapp/myapp/bin/myapp /entrypoint.sh

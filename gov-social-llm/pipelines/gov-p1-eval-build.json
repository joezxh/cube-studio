{
  "pipeline": {
    "name": "gov-p1-eval-build",
    "describe": "P1 评测集构建：导入→隐私脱敏→dev/blind 切分→盲测集封存",
    "project": "社会治理",
    "parameter": {},
    "dag_json": {
      "import-eval": {},
      "mask-eval": {"upstream": ["import-eval"]},
      "split-eval": {"upstream": ["mask-eval"]},
      "seal-blind": {"upstream": ["split-eval"]}
    },
    "global_env": "DATA_ROOT=/mnt/gov",
    "expand": [
      {"id": "import-eval", "type": "dataSet", "position": {"x": 200, "y": 200}, "data": {"info": {"describe": "导入原始评测集"}, "name": "import-eval", "label": "导入评测集"}},
      {"id": "mask-eval", "type": "dataSet", "position": {"x": 400, "y": 200}, "data": {"info": {"describe": "隐私实体替换脱敏"}, "name": "mask-eval", "label": "隐私脱敏"}},
      {"id": "split-eval", "type": "dataSet", "position": {"x": 600, "y": 200}, "data": {"info": {"describe": "dev/blind/redteam 切分"}, "name": "split-eval", "label": "切分评测集"}},
      {"id": "seal-blind", "type": "dataSet", "position": {"x": 800, "y": 200}, "data": {"info": {"describe": "盲测集只读封存"}, "name": "seal-blind", "label": "封存盲测"}}
    ]
  },
  "tasks": [
    {
      "job_templete": "dataset",
      "name": "import-eval",
      "label": "导入评测集",
      "volume_mount": "gov-nfs(pvc):/mnt",
      "resource_memory": "2G",
      "resource_cpu": "2",
      "resource_gpu": "0",
      "args": {"--dataset_name": "gov-eval-raw", "--dataset_version": "v1", "--out_path": "/mnt/gov/eval/raw/v1/eval.jsonl"}
    },
    {
      "job_templete": "nlp-replace-private-data",
      "name": "mask-eval",
      "label": "隐私脱敏",
      "volume_mount": "gov-nfs(pvc):/mnt",
      "resource_memory": "4G",
      "resource_cpu": "4",
      "resource_gpu": "0",
      "args": {"--input": "/mnt/gov/eval/raw/v1/eval.jsonl", "--output": "/mnt/gov/eval/masked/v1/eval.jsonl"}
    },
    {
      "job_templete": "python",
      "name": "split-eval",
      "label": "切分评测集",
      "volume_mount": "gov-nfs(pvc):/mnt",
      "resource_memory": "2G",
      "resource_cpu": "2",
      "resource_gpu": "0",
      "args": {"--command": "python /mnt/gov/scripts/eval_split.py --input /mnt/gov/eval/masked/v1/eval.jsonl --dev-out /mnt/gov/eval/dev/v1/eval.jsonl --blind-out /mnt/gov/eval/blind/v1/eval.jsonl --redteam-out /mnt/gov/eval/redteam/v1/eval.jsonl --ratio 0.7 --seed 42"}
    },
    {
      "job_templete": "gov-manifest",
      "name": "seal-blind",
      "label": "封存盲测",
      "volume_mount": "gov-nfs(pvc):/mnt",
      "resource_memory": "2G",
      "resource_cpu": "1",
      "resource_gpu": "0",
      "args": {"--cmd": "seal", "--dir": "/mnt/gov/eval/blind/v1"}
    }
  ]
}
